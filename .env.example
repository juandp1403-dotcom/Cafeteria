# ============================================================
# CAFETERÍA SENA CGAO - VARIABLES DE ENTORNO (PLANTILLA)
# Copia este archivo a `.env` y rellena con tus valores reales.
# NUNCA subas `.env` con credenciales reales al repositorio.
# ============================================================

# --- SUPABASE (desplegado en Supabase Console / Dashboard) ---

# URL del proyecto Supabase (https://<ref>.supabase.co)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# PUBLISHABLE / ANON KEY (cliente del navegador). Se expone al frontend.
# En Supabase Dashboard: Settings > API keys > anon public / publishable.
VITE_SUPABASE_ANON_KEY=sb_publishable_tu_clave_anon_aqui

# --- SERVIDOR (solo Node/backend, nunca en el cliente) ---

# URL del proyecto Supabase (servidor)
SUPABASE_URL=https://tu-proyecto.supabase.co

# SERVICE ROLE KEY (solo servidor; NUNCA exponer en el navegador)
# Supabase Console > Project Settings > API Keys > service_role secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...tu_service_role_key_aqui

# Publishable key (opcional, solo para diagnóstico en /api/supabase/status)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu_clave_anon_aqui